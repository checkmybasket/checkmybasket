# Copy to .env.staging.local (ignored). Fill only after staging is provisioned.
# Never copy .env.local: it currently points at production.
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_WITH_STAGING_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3101
VERCEL_ENV=preview

# Explicit integration-test targets; these never fall back to app variables.
CMB_TEST_PROJECT_REF=REPLACE_WITH_STAGING_REF
CMB_TEST_SUPABASE_URL=https://REPLACE_WITH_STAGING_REF.supabase.co
CMB_TEST_SUPABASE_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
CMB_TEST_APP_URL=http://localhost:3101

# Do not put service-role/secret keys, SMTP or Resend credentials here.
# Email providers must remain disconnected until an isolated sink is configured.
